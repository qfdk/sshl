<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SSHL.app 的 Info.plist 模板：scripts/bundle.sh 把 __VERSION__ 换成 Cargo.toml 的版本号、__MIN_MACOS__ 换成二进制的最低系统版本。 -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh_CN</string>
		<string>en</string>
	</array>
	<!-- 能用 SSHL 打开文件夹（在那个目录开本机终端，见 crates/app/src/open_request.rs）：open -a SSHL 目录、拖到程序坞图标上、
	     访达工具栏按钮都靠它。Alternate：不抢访达打开文件夹的默认（同 Ghostty）。 -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folders</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.directory</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDisplayName</key>
	<string>SSHL</string>
	<key>CFBundleExecutable</key>
	<string>sshl</string>
	<key>CFBundleIconFile</key>
	<string>icon</string>
	<key>CFBundleIdentifier</key>
	<string>me.qfdk.sshl</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>SSHL</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>__MIN_MACOS__</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- 访达工具栏按钮（Contents/Helpers/Open in SSHL.app）问访达当前目录：它算 SSHL 的，系统问的是 SSHL 能不能控制访达 -->
	<key>NSAppleEventsUsageDescription</key>
	<string>SSHL reads the folder shown in Finder to open a terminal there.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>SSHL needs local network access to connect to SSH servers on your LAN.</string>
</dict>
</plist>
