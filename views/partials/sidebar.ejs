<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <div class="app-logo">SSHL</div>
      <button id="toggle-sidebar" class="icon-button">
        <i data-lucide="chevron-left" data-size="16"></i>
      </button>
    </div>

    <button id="new-connection-btn" class="primary-button">
      <i data-lucide="plus" data-size="18" data-stroke="2.75"></i>
      <span>新建连接</span>
    </button>

    <div class="search-box">
      <input type="text" id="connection-search" placeholder="搜索连接..." autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false">
    </div>

    <div class="connection-list" id="connection-list">
      <% const groupedConnections = new Map(); %>
      <% (connections || []).forEach(function(connection) { %>
        <% const groupName = (connection.group || '').trim() || '未分组'; %>
        <% if (!groupedConnections.has(groupName)) groupedConnections.set(groupName, []); %>
        <% groupedConnections.get(groupName).push(connection); %>
      <% }); %>
      <% if (groupedConnections.size > 0) { %>
        <% groupedConnections.forEach(function(groupConnections, groupName) { %>
          <section class="connection-group" data-group="<%= groupName %>">
            <button type="button" class="connection-group-header" data-group="<%= groupName %>" aria-expanded="true">
              <span class="connection-group-name"><%= groupName %></span>
              <span class="connection-group-count"><%= groupConnections.length %></span>
            </button>
            <div class="connection-group-items">
              <% groupConnections.forEach(function(connection) { %>
                <div class="connection-item" data-id="<%= connection.id %>">
                  <div class="connection-status-indicator offline"></div>
                  <div class="connection-name"><%= connection.name %></div>
                  <div class="connection-actions">
                    <button class="icon-button delete-connection" data-id="<%= connection.id %>">
                      <i data-lucide="trash-2" data-size="12"></i>
                    </button>
                  </div>
                </div>
              <% }); %>
            </div>
          </section>
        <% }); %>
      <% } else { %>
        <div class="no-connections">没有保存的连接</div>
      <% } %>
    </div>

    <div class="sidebar-footer">
      <button id="open-settings-btn" class="icon-button sidebar-footer-btn" title="设置">
        <i data-lucide="settings" data-size="16"></i>
        <span>设置</span>
      </button>
    </div>
  </div>
