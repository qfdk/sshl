<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <div class="app-logo">SSHL</div>
      <button id="toggle-sidebar" class="icon-button">
        <i data-lucide="chevron-left" data-size="16"></i>
      </button>
    </div>

    <button id="new-connection-btn" class="primary-button">
      <i data-lucide="plus" data-size="18" data-stroke="2.75"></i>
      <span>新建连接</span>
    </button>

    <div class="search-box">
      <input type="text" id="connection-search" placeholder="搜索连接..." autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false">
    </div>

    <div class="connection-list" id="connection-list"></div>

    <div class="sidebar-footer">
      <button id="open-settings-btn" class="icon-button sidebar-footer-btn" title="设置">
        <i data-lucide="settings" data-size="16"></i>
        <span>设置</span>
      </button>
    </div>
  </div>
