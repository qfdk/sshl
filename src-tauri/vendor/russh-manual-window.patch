+    /// Stop refilling `channel`'s receive window as data arrives; the application
+    /// grants window explicitly once it has consumed the data (`grant_window`).
+    pub fn set_manual_window(&mut self, channel: ChannelId) {
+        if let Some(channel) = self.channels.get_mut(&channel) {
+            channel.manual_window = true;
+        }
+    }
+
+    /// Send CHANNEL_WINDOW_ADJUST(`amount`) on a manual-window channel.
+    pub fn grant_window(&mut self, channel: ChannelId, amount: u32) {
+        if let Some(channel) = self.channels.get_mut(&channel) {
+            let amount = amount.min(u32::MAX - channel.sender_window_size);
+            if !channel.manual_window || !channel.confirmed || amount == 0 {
+                return;
+            }
+            push_packet!(self.write, {
+                self.write.push(msg::CHANNEL_WINDOW_ADJUST);
+                self.write.push_u32_be(channel.recipient_channel);
+                self.write.push_u32_be(amount);
+            });
+            channel.sender_window_size += amount;
+        }
+    }
