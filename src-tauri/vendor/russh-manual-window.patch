+    /// arrives: the server can send at most `window_size` plus what
+    /// [`Channel::grant_window`] grants. A consumer that falls behind therefore pauses
+    /// this channel only, instead of growing an unbounded queue (other channels on the
+    /// connection keep flowing).
+    pub async fn channel_open_session_manual_window(
+        &self,
+        window_size: u32,
+    ) -> Result<Channel<Msg>, crate::Error> {
+        let (sender, receiver) = unbounded_channel();
+        let channel_ref = ChannelRef::new(sender);
+        let window_size_ref = channel_ref.window_size().clone();
+
+        self.sender
+            .send(Msg::ChannelOpenSessionManualWindow {
+                channel_ref,
+                window_size,
+            })
+            .await
+            .map_err(|_| crate::Error::SendError)?;
+        self.wait_channel_confirmation(receiver, window_size_ref)
+            .await
+    }
